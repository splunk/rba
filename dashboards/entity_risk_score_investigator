<form version="1.1" theme="dark">
  <label>Entity Risk Scoring Investigator</label>
  <fieldset submitButton="false">
    <input type="text" token="risk_object">
      <label>risk_object_field</label>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
    <input type="text" token="ers_floor">
      <label>ers_floor</label>
      <default>50</default>
      <initialValue>50</initialValue>
    </input>
  </fieldset>
  <row>
    <panel rejects="$deepdive$">
      <table>
        <title>Click to Investigate Individual Object</title>
        <search>
          <query>| inputlookup ers_lookup where ers&gt;$ers_floor$
| fields normalized_risk_object risk_object_type ers category detections
| fields - _time</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">cell</option>
        <drilldown>
          <set token="deepdive">$click.value$</set>
          <set token="deepdive_type">$row.risk_object_type$</set>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$deepdive$">
      <table>
        <title>$deepdive$ Object Details - Click to Return ERS List</title>
        <search>
          <done>
            <set token="collection">$result._collection$</set>
          </done>
          <query>| inputlookup ers_lookup where normalized_risk_object=$deepdive$ risk_object_type="$deepdive_type$"
| fields normalized_risk_object risk_object_type ers
| join type=left normalized_risk_object [
| inputlookup asset_lookup_by_str where asset="$deepdive$"
| fields priority category asset operatingSystem dns
| rename dns AS normalized_risk_object
| eval collection_asset = mvjoin(asset,"\",\"")]
| join type=left normalized_risk_object [
| inputlookup identity_lookup_expanded where identity="$deepdive$"
| fields priority bunit title identity work_city work_country managedBy phone sAMAccountName
| rename sAMAccountName AS normalized_risk_object
| eval collection_identity = mvjoin(identity,"\",\"")]
| eval collection = coalesce(collection_asset,collection_identity,normalized_risk_object)
| fields - _time collection_asset collection_identity
| stats values(*) as *
| fields normalized_risk_object risk_object_type ers *
| rex mode=sed field=collection "s/\\\\/\\\\\\\/g"
| rename collection AS _collection</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">cell</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <unset token="deepdive"></unset>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$deepdive$">
      <table>
        <search>
          <query>| tstats values(All_Risk.threat_object_info) as threat_object_info from datamodel=Risk.All_Risk WHERE All_Risk.normalized_risk_object="$deepdive$" All_Risk.risk_object_type="$deepdive_type$" earliest=-7d latest=now by All_Risk.normalized_risk_object All_Risk.risk_object_type source All_Risk.risk_message _time span=1s 
    | `drop_dm_object_name(All_Risk)` 
    | rex field=threat_object_info mode=sed "s/(.*)(\-.+)/---\2: \1/g" 
    | eval risk_message = "--".risk_message 
    | sort + _time 
    | eval time = strftime(_time,"%Y-%m-%d %H:%M:%S") 
    | eval risk_message = mvappend(time,source,risk_message,threat_object_info," ") 
    | nomv risk_message 
    | stats list(risk_message) as risk_message_timeline by normalized_risk_object risk_object_type
    | fields risk_message_timeline</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$deepdive$">
      <table>
        <title>Click to Display Finding for "$collection$"</title>
        <search>
          <query>`get_notable_index` src IN ("$collection$") OR dest IN ("$collection$") OR user IN ("$collection$") OR src_user IN ("$collection$")
| eval indexer_guid=replace('_bkt',".*~(.+)","\\1"), event_hash=md5(('_time' . '_raw')), event_id=((((indexer_guid . "@@") . index) . "@@") . event_hash), rule_id=event_id 
| eval latest=_time + 1800, earliest=_time - 1800 
| search event_id="*" 
| fields - "host_*" 
| tags outputfield=tag 
| eval tag=mvdedup(mvappend(tag,NULL,orig_tag)) 
| dedup rule_id 
| lookup update=true notable_xref_lookup event_id OUTPUTNEW xref_name as notable_xref_name,xref_id as notable_xref_id 
| eval notable_xref=mvzip(notable_xref_name,notable_xref_id,":") 
| eval temp_time=(time() + 86400) 
| lookup update=true event_time_field=temp_time incident_review_lookup rule_id OUTPUT owner as new_owner, urgency as new_urgency, status as new_status, disposition as new_disposition 
| lookup update=true event_time_field=temp_time incident_review_comment_lookup rule_id OUTPUT time as review_time,user as reviewer,comment 
| eval owner=if(isnotnull(new_owner),new_owner,owner), status=case(isnotnull(new_status),new_status,isnotnull(status),status,true(),default_status), urgency=if(isnotnull(new_urgency),new_urgency,urgency), disposition=if(isnotnull(new_disposition),new_disposition,default_disposition) 
| fields - temp_time, new_owner, new_status, new_urgency, new_disposition 
| eval temp_status=if(isnull(status),-1,status) 
| lookup update=true reviewstatuses_lookup _key as temp_status OUTPUT status,label as status_label,description as status_description,default as status_default,end as status_end 
| eval status=if(isnull(status_label),0,status), status_label=if(isnull(status_label),"Unassigned",status_label), status_description=if(isnull(status_description),"unknown",status_description), status_default=case(match(status_default,"1|[Tt]|[Tt][Rr][Uu][Ee]"),"true",match(status_default,"0|[Ff]|[Ff][Aa][Ll][Ss][Ee]"),"false",true(),status_default), status_end=case(match(status_end,"1|[Tt]|[Tt][Rr][Uu][Ee]"),"true",match(status_end,"0|[Ff]|[Ff][Aa][Ll][Ss][Ee]"),"false",true(),status_end), status_group=case((status_default == "true"),"New",(status_end == "true"),"Closed",(status == 0),"New",true(),"Open") 
| fields - temp_status 
| eval temp_disposition=if(isnull(disposition),-3,disposition) 
| lookup update=true disposition_lookup _key as temp_disposition OUTPUT status as disposition,label as disposition_label,description as disposition_description,default as disposition_default 
| eval disposition=if(isnull(disposition),"disposition:0",disposition), disposition_label=if(isnull(disposition_label),"Unassigned",disposition_label), disposition_description=if(isnull(disposition_description),"An error is preventing the event from having a valid disposition.",disposition_description), disposition_default=case(match(disposition_default,"1|[Tt]|[Tt][Rr][Uu][Ee]"),"true",match(disposition_default,"0|[Ff]|[Ff][Aa][Ll][Ss][Ee]"),"false",true(),disposition_default) 
| fields - temp_disposition 
| table _time, orig_time, orig_rule_title, search_name, orig_source, status_label, status_end, comment, owner, reviewer, risk_object, risk_object_type, risk_messages, src, user, dest, rule_id, event_hash, earliest, latest 
| eventstats count as notable_count count(eval(status_label="Incident")) as incident_count 
| eval incident_count = if(isnull(incident_count),"0",incident_count) 
| rename status_label as status 
| table _time, orig_time, orig_rule_title search_name, orig_source, status_label, status_end, comment, owner, reviewer, risk_object, risk_object_type, risk_messages, src, user, dest, rule_id, event_hash, earliest, latest, incident_count, status, notable_count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <fields>["_time","orig_rule_title","owner","status","comment"]</fields>
        <option name="drilldown">cell</option>
        <drilldown>
            <link target="_blank">/app/SplunkEnterpriseSecuritySuite/incident_review?earliest=$row.earliest$&amp;latest=$row.latest$&amp;search=rule_title%3D"$row.orig_rule_title$"</link>
        </drilldown>
      </table>
    </panel>
  </row>
</form>
